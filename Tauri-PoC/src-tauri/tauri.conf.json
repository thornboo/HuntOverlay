{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HuntOverlay Tauri PoC",
  "version": "0.1.0",
  "identifier": "dev.huntoverlay.tauri-poc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "control",
        "title": "HuntOverlay · Tauri Overlay Flight Test",
        "url": "index.html?window=control",
        "width": 1040,
        "height": 660,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "HuntOverlay Tauri PoC Overlay",
        "url": "index.html?window=overlay",
        "width": 1280,
        "height": 720,
        "visible": false,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
